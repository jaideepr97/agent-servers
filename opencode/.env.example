# OpenCode serve connection
OPENCODE_BASE_URL=http://127.0.0.1:4096

# A2A server
A2A_HOST=127.0.0.1
A2A_PORT=8000
A2A_PUBLIC_URL=http://127.0.0.1:8000

# Agent card — required fields
A2A_TITLE=OpenCode
A2A_DESCRIPTION=AI-powered coding assistant
A2A_VERSION=1.0.0

# Agent card — optional fields
A2A_DOCUMENTATION_URL=https://opencode.ai/docs
A2A_PROVIDER_ORG=Red Hat
A2A_PROVIDER_URL=https://redhat.com
A2A_ICON_URL=https://opencode.ai/favicon-v3.svg
